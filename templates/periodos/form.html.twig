{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}{{ titulo }}{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina(accion == 'crear' ? 'Nuevo período' : 'Editar período', {
    ruta: [{texto: 'Administración'}, {texto: 'Períodos de pago', url: url_for('periodos.index')}, {texto: accion == 'crear' ? 'Nuevo' : 'Editar'}],
    acciones: [
        {texto: 'Cancelar', tipo: 'secundario', url: url_for('periodos.index')},
        {texto: accion == 'crear' ? 'Guardar período' : 'Actualizar período', icono: 'floppy', form: 'form-periodo'}
    ]
}) }}
{% endblock %}

{% block contenido %}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">

        {% if errores|length > 0 %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for error in errores %}<li>{{ error }}</li>{% endfor %}
            </ul>
        </div>
        {% endif %}

        <div class="alert alert-info small">
            <i class="bi bi-info-circle me-1"></i>
            Solo se aceptan períodos del <strong>1 al 15</strong> o del
            <strong>16 al último día</strong> del mismo mes.
        </div>

        {% if accion == 'crear' %}
            {% set form_action = url_for('periodos.store') %}
        {% else %}
            {% set form_action = url_for('periodos.update', {'id': periodo.id_periodo}) %}
        {% endif %}

        <form method="POST" action="{{ form_action }}" novalidate id="form-periodo">
            {% embed 'partials/seccion.html.twig' with {titulo: 'Datos del período'} %}
            {% block cuerpo %}
                <div class="mb-3">
                    <label for="fecha_inicio" class="form-label fw-semibold">
                        Fecha inicio <span class="text-danger">*</span>
                    </label>
                    <input type="date" class="form-control" id="fecha_inicio"
                           name="fecha_inicio" required
                           value="{{ periodo.fecha_inicio ?? '' }}">
                </div>

                <div class="mb-3">
                    <label for="fecha_fin" class="form-label fw-semibold">
                        Fecha fin <span class="text-danger">*</span>
                    </label>
                    <input type="date" class="form-control" id="fecha_fin"
                           name="fecha_fin" required
                           value="{{ periodo.fecha_fin ?? '' }}">
                </div>

                {% if accion == 'editar' %}
                <div class="mb-3">
                    <label for="estado" class="form-label fw-semibold">Estado</label>
                    <select class="form-select" id="estado" name="estado">
                        <option value="abierto"  {{ periodo.estado == 'abierto'  ? 'selected' : '' }}>Abierto</option>
                        <option value="cerrado"  {{ periodo.estado == 'cerrado'  ? 'selected' : '' }}>Cerrado</option>
                    </select>
                    <div class="form-text text-warning">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Un período cerrado no puede reabrirse.
                    </div>
                </div>
                {% endif %}
            {% endblock %}
            {% endembed %}
        </form>

    </div>
</div>
{% endblock %}
