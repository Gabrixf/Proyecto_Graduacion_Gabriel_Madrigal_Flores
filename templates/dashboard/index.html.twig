{% extends 'layouts/base.html.twig' %}

{% block titulo %}Dashboard{% endblock %}
{% block breadcrumb %}Inicio / Panel de Control{% endblock %}

{% block contenido %}

<p class="text-muted mb-4">
    Bienvenido, <strong>{{ session.usuario_nombre }}</strong>
    &mdash; {{ "now"|date("d/m/Y") }}
</p>

{% if session.usuario_rol == 'admin' %}

{# ── KPIs ── #}
<div class="row g-3 mb-4">

    <div class="col-sm-6 col-lg-3">
        <a href="{{ url_for('empleados.index') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Empleados</div>
                        <div class="value">{{ kpis.empleados_activos }}</div>
                        <div class="sub">Activos en plantilla</div>
                    </div>
                    <div class="chip green"><i class="bi bi-people-fill"></i></div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <a href="{{ url_for('solicitudes.index') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Solicitudes</div>
                        <div class="value {{ kpis.solicitudes_pendientes > 0 ? 'text-danger' : '' }}">
                            {{ kpis.solicitudes_pendientes }}
                        </div>
                        <div class="sub">Pendientes de revisión</div>
                    </div>
                    <div class="chip {{ kpis.solicitudes_pendientes > 0 ? 'red' : 'navy' }}">
                        <i class="bi bi-inbox-fill"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <a href="{{ url_for('nominas.index') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Nóminas</div>
                        <div class="value">{{ kpis.nominas_borrador }}</div>
                        <div class="sub">En borrador este período</div>
                    </div>
                    <div class="chip red"><i class="bi bi-receipt"></i></div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <a href="{{ url_for('periodos.index') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Período abierto</div>
                        {% if kpis.periodo %}
                        <div class="value" style="font-size:1.1rem">
                            {{ kpis.periodo.fecha_inicio|date('d/m') }} – {{ kpis.periodo.fecha_fin|date('d/m/Y') }}
                        </div>
                        <div class="sub">Quincena en curso</div>
                        {% else %}
                        <div class="value" style="font-size:1.1rem; color:var(--lb-muted)">—</div>
                        <div class="sub">Sin período abierto</div>
                        {% endif %}
                    </div>
                    <div class="chip amber"><i class="bi bi-calendar-range"></i></div>
                </div>
            </div>
        </a>
    </div>

</div>

{# ── Accesos rápidos ── #}
<h6 class="text-muted fw-semibold mb-3" style="font-size:.75rem;letter-spacing:.06em;text-transform:uppercase">
    Accesos rápidos
</h6>
<div class="row g-3">

    <div class="col-sm-6 col-lg-3">
        <a href="{{ url_for('puestos.index') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Mantenimientos</div>
                        <div class="value h5 mb-0 mt-1">Puestos</div>
                        <div class="sub">Catálogo de puestos</div>
                    </div>
                    <div class="chip navy"><i class="bi bi-briefcase"></i></div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <a href="{{ url_for('empleados.index') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Gestión</div>
                        <div class="value h5 mb-0 mt-1">Empleados</div>
                        <div class="sub">Personal de la empresa</div>
                    </div>
                    <div class="chip green"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <a href="{{ url_for('nominas.index') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Quincenal</div>
                        <div class="value h5 mb-0 mt-1">Nóminas</div>
                        <div class="sub">Cálculo de planilla</div>
                    </div>
                    <div class="chip red"><i class="bi bi-cash-coin"></i></div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <a href="{{ url_for('reportes.index') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Consultas</div>
                        <div class="value h5 mb-0 mt-1">Reportes</div>
                        <div class="sub">Informes del sistema</div>
                    </div>
                    <div class="chip amber"><i class="bi bi-graph-up"></i></div>
                </div>
            </div>
        </a>
    </div>

</div>

{% else %}

{# ── KPIs empleado ── #}
<div class="row g-3 mb-4">

    <div class="col-sm-6 col-lg-4">
        <a href="{{ url_for('portal.colillas') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Mis Colillas</div>
                        <div class="value">{{ kpis.colillas }}</div>
                        <div class="sub">Comprobantes disponibles</div>
                    </div>
                    <div class="chip red"><i class="bi bi-receipt"></i></div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a href="{{ url_for('portal.vacaciones') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Vacaciones disponibles</div>
                        <div class="value">{{ kpis.dias_vacaciones|number_format(1, '.', ',') }}</div>
                        <div class="sub">Días acumulados {{ "now"|date('Y') }}</div>
                    </div>
                    <div class="chip green"><i class="bi bi-sun"></i></div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a href="{{ url_for('portal.colillas') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Último salario neto</div>
                        {% if kpis.ultimo_salario is not null %}
                        <div class="value" style="font-size:1.2rem">
                            ₡{{ kpis.ultimo_salario|number_format(2, '.', ',') }}
                        </div>
                        {% else %}
                        <div class="value" style="font-size:1.2rem;color:var(--lb-muted)">—</div>
                        {% endif %}
                        <div class="sub">Nómina más reciente</div>
                    </div>
                    <div class="chip navy"><i class="bi bi-wallet2"></i></div>
                </div>
            </div>
        </a>
    </div>

</div>

{# ── Accesos rápidos empleado ── #}
<h6 class="text-muted fw-semibold mb-3" style="font-size:.75rem;letter-spacing:.06em;text-transform:uppercase">
    Accesos rápidos
</h6>
<div class="row g-3">
    <div class="col-sm-6 col-lg-4">
        <a href="{{ url_for('portal.colillas') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Consulta</div>
                        <div class="value h5 mb-0 mt-1">Mis Colillas</div>
                        <div class="sub">Comprobantes de pago</div>
                    </div>
                    <div class="chip red"><i class="bi bi-receipt"></i></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-4">
        <a href="{{ url_for('portal.vacaciones') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Saldo</div>
                        <div class="value h5 mb-0 mt-1">Mis Vacaciones</div>
                        <div class="sub">Días disponibles</div>
                    </div>
                    <div class="chip green"><i class="bi bi-sun"></i></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-4">
        <a href="{{ url_for('portal.perfil') }}" class="card-link">
            <div class="card-fo">
                <div class="stat">
                    <div>
                        <div class="label">Cuenta</div>
                        <div class="value h5 mb-0 mt-1">Mi Perfil</div>
                        <div class="sub">Información personal</div>
                    </div>
                    <div class="chip navy"><i class="bi bi-person-lines-fill"></i></div>
                </div>
            </div>
        </a>
    </div>
</div>

{% endif %}

{% endblock %}
