{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}Empleados{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina('Empleados', {
    ruta: [{texto: 'Plataforma'}, {texto: 'Empleados'}],
    conteo: empleados|length,
    acciones: [{texto: 'Nuevo empleado', icono: 'plus-lg', url: url_for('empleados.create')}]
}) }}
{% endblock %}

{% block contenido %}
{# Filtros y búsqueda #}
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">

    <div class="btn-group btn-group-sm" role="group">
        <a href="{{ url_for('empleados.index') }}?estado=activo{{ q ? '&q=' ~ q|url_encode : '' }}"
           class="btn {{ estadoActual == 'activo' ? 'btn-primary' : 'btn-outline-primary' }}">Activos</a>
        <a href="{{ url_for('empleados.index') }}?estado=inactivo{{ q ? '&q=' ~ q|url_encode : '' }}"
           class="btn {{ estadoActual == 'inactivo' ? 'btn-primary' : 'btn-outline-primary' }}">Inactivos</a>
        <a href="{{ url_for('empleados.index') }}?estado=todos{{ q ? '&q=' ~ q|url_encode : '' }}"
           class="btn {{ estadoActual == 'todos' ? 'btn-primary' : 'btn-outline-primary' }}">Todos</a>
    </div>

    <form method="GET" action="{{ url_for('empleados.index') }}" class="d-flex gap-1 ms-auto">
        <input type="hidden" name="estado" value="{{ estadoActual }}">
        <input type="text" name="q" value="{{ q }}"
               class="form-control form-control-sm"
               placeholder="Buscar por nombre, cédula o puesto…"
               style="min-width:260px">
        <button class="btn btn-sm btn-outline-primary" title="Buscar">
            <i class="bi bi-search"></i>
        </button>
        {% if q %}
        <a href="{{ url_for('empleados.index') }}?estado={{ estadoActual }}"
           class="btn btn-sm btn-outline-secondary" title="Limpiar búsqueda">
            <i class="bi bi-x-lg"></i>
        </a>
        {% endif %}
    </form>

</div>

{% if empleados|length == 0 %}
<div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i>
    {% if q %}
        No se encontraron empleados para <strong>"{{ q }}"</strong>.
        <a href="{{ url_for('empleados.index') }}?estado={{ estadoActual }}" class="alert-link">Limpiar búsqueda</a>
    {% else %}
        No hay empleados que coincidan con el filtro seleccionado.
    {% endif %}
</div>
{% else %}
<div class="lb-tabla">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre completo</th>
                    <th>Cédula</th>
                    <th>Puesto</th>
                    <th>Ingreso</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for e in empleados %}
                <tr>
                    <td class="text-muted small">{{ e.id_empleado }}</td>
                    <td class="fw-semibold">{{ e.apellidos }}, {{ e.nombre }}</td>
                    <td>{{ e.cedula }}</td>
                    <td>{{ e.puesto_nombre }}</td>
                    <td>{{ e.fecha_ingreso|date('d/m/Y') }}</td>
                    <td class="text-center">
                        {{ ui.estado(e.estado) }}
                    </td>
                    <td class="text-center">
                        <a href="{{ url_for('empleados.edit', {'id': e.id_empleado}) }}"
                           class="btn btn-sm btn-outline-primary me-1" title="Editar">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        {% if e.estado == 'activo' %}
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                title="Desactivar"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEliminar"
                                data-id="{{ e.id_empleado }}"
                                data-nombre="{{ e.apellidos }}, {{ e.nombre }}">
                            <i class="bi bi-person-dash"></i>
                        </button>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="lb-tabla__pie">{{ empleados|length }} {{ empleados|length == 1 ? 'empleado' : 'empleados' }}</div>
</div>
{% endif %}

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-1"></i>Confirmar desactivación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Desactivar al empleado <strong id="modalNombreEmpleado"></strong>?
                Su información se conserva, pero quedará marcado como inactivo.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminar" method="POST" action="">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-person-dash me-1"></i>Desactivar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('modalEliminar').addEventListener('show.bs.modal', function (event) {
    const btn    = event.relatedTarget;
    const id     = btn.getAttribute('data-id');
    const nombre = btn.getAttribute('data-nombre');
    document.getElementById('modalNombreEmpleado').textContent = '"' + nombre + '"';
    document.getElementById('formEliminar').action = '/empleados/' + id + '/eliminar';
});
</script>
{% endblock %}
