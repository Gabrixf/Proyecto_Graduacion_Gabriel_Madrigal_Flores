{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}Detalle de Liquidación{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina(liquidacion.nombre ~ ' ' ~ liquidacion.apellidos, {
    ruta: [{texto: 'Nómina'}, {texto: 'Liquidaciones', url: url_for('liquidacion.index')}, {texto: 'Detalle'}],
    acciones: [{texto: 'Eliminar', icono: 'trash3', tipo: 'peligro', atributos: {'data-bs-toggle': 'modal', 'data-bs-target': '#modalEliminar'}}]
}) }}
{% endblock %}

{% block contenido %}
<div style="max-width:640px">
    {% embed 'partials/seccion.html.twig' with {titulo: 'Datos de la salida'} %}
    {% block cuerpo %}
        <div class="text-muted small">
            Motivo: {{ liquidacion.motivo|replace({'_': ' '})|capitalize }} ·
            Salida: {{ liquidacion.fecha_salida }} ·
            Ingreso: {{ liquidacion.fecha_ingreso }}
        </div>
    {% endblock %}
    {% endembed %}

    <div class="lb-tabla">
        <div class="table-responsive">
        <table class="table align-middle mb-0">
            <tbody>
                <tr><td>Preaviso</td><td class="text-end">₡{{ liquidacion.preaviso|number_format(2, '.', ',') }}</td></tr>
                <tr><td>Cesantía</td><td class="text-end">₡{{ liquidacion.cesantia|number_format(2, '.', ',') }}</td></tr>
                <tr><td>Vacaciones pendientes</td><td class="text-end">₡{{ liquidacion.vacaciones_pendientes|number_format(2, '.', ',') }}</td></tr>
                <tr><td>Aguinaldo proporcional</td><td class="text-end">₡{{ liquidacion.aguinaldo_proporcional|number_format(2, '.', ',') }}</td></tr>
            </tbody>
            <tfoot>
                <tr class="fw-bold fs-5"><td>Total liquidación</td><td class="text-end">₡{{ liquidacion.total_liquidacion|number_format(2, '.', ',') }}</td></tr>
            </tfoot>
        </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-1"></i>Eliminar liquidación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Eliminar la liquidación de <strong>{{ liquidacion.nombre }} {{ liquidacion.apellidos }}</strong>?</p>
                <p class="text-muted small mb-0">Esta acción es irreversible y eliminará el registro permanentemente.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="POST" action="{{ url_for('liquidacion.destroy', {id: liquidacion.id_liquidacion}) }}">
                    <button class="btn btn-danger"><i class="bi bi-trash me-1"></i>Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
