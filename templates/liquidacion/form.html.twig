{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}Nueva Liquidación{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina('Nueva liquidación', {
    ruta: [{texto: 'Nómina'}, {texto: 'Liquidaciones', url: url_for('liquidacion.index')}, {texto: 'Nueva'}],
    acciones: [
        {texto: 'Cancelar', tipo: 'secundario', url: url_for('liquidacion.index')},
        {texto: 'Calcular liquidación', icono: 'calculator', form: 'form-liquidacion'}
    ]
}) }}
{% endblock %}

{% block contenido %}
<div style="max-width:640px">
    {% if errores %}
    <div class="alert alert-danger">
        {% for e in errores %}<div><i class="bi bi-exclamation-triangle-fill me-1"></i>{{ e }}</div>{% endfor %}
    </div>
    {% endif %}

    <form method="POST" action="{{ url_for('liquidacion.store') }}" id="form-liquidacion">
        {% embed 'partials/seccion.html.twig' with {titulo: 'Datos de la salida'} %}
        {% block cuerpo %}
            <div class="mb-3">
                <label class="form-label fw-semibold">Empleado</label>
                <select name="id_empleado" class="form-select" required>
                    <option value="">— Seleccione —</option>
                    {% for e in empleados %}
                    <option value="{{ e.id_empleado }}" {{ datos.id_empleado == e.id_empleado ? 'selected' : '' }}>
                        {{ e.nombre }} {{ e.apellidos }}
                    </option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Motivo de salida</label>
                <select name="motivo" class="form-select" required>
                    <option value="">— Seleccione —</option>
                    {% for valor, etiqueta in motivos %}
                    <option value="{{ valor }}" {{ datos.motivo == valor ? 'selected' : '' }}>{{ etiqueta }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Fecha de salida</label>
                <input type="date" name="fecha_salida" value="{{ datos.fecha_salida }}" class="form-control" required>
                <div class="form-text">Los días de vacaciones pendientes salen del saldo del empleado a esa fecha.</div>
            </div>
        {% endblock %}
        {% endembed %}
    </form>
</div>
{% endblock %}
