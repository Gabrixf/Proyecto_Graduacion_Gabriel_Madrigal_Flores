{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}{{ titulo }}{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina(accion == 'crear' ? 'Nueva solicitud' : 'Editar solicitud', {
    ruta: [{texto: 'Mi cuenta'}, {texto: 'Mis solicitudes', url: url_for('portal.solicitudes')}, {texto: accion == 'crear' ? 'Nueva' : 'Editar'}],
    acciones: [
        {texto: 'Cancelar', tipo: 'secundario', url: url_for('portal.solicitudes')}, 
        {texto: accion == 'crear' ? 'Enviar' : 'Actualizar', icono: 'floppy', form: 'form-solicitud-portal', id: 'btnEnviar'}
    ]
}) }}
{% endblock %}

{% block contenido %}
<div style="max-width:600px">
    {% if errores|length > 0 %}
    <div class="alert alert-danger"><ul class="mb-0">{% for e in errores %}<li>{{ e }}</li>{% endfor %}</ul></div>
    {% endif %}

    {% if saldoVacaciones is not null and saldoVacaciones.en_prueba %}
    <div class="alert alert-info small">
        <i class="bi bi-info-circle me-1"></i>Está en período de prueba hasta el
        <strong>{{ saldoVacaciones.fin_prueba|date('d/m/Y') }}</strong>; sus vacaciones deben iniciar a partir de esa fecha.
    </div>
    {% endif %}
    {% if sinDiasVacaciones %}
    <div class="alert alert-warning small">
        <i class="bi bi-exclamation-triangle me-1"></i>No tiene días de vacaciones disponibles por ahora, así que no
        puede solicitar vacaciones. Los días se acumulan a razón de 1 por mes completo trabajado.
    </div>
    {% endif %}

    {% if accion == 'crear' %}
        {% set form_action = url_for('portal.solicitudes.guardar') %}
    {% else %}
        {% set form_action = url_for('portal.solicitudes.actualizar', {'id': solicitud.id_solicitud}) %}
    {% endif %}

    <form method="POST" action="{{ form_action }}" novalidate id="form-solicitud-portal">
        {% embed 'partials/seccion.html.twig' with {titulo: 'Datos de la solicitud'} %}
        {% block cuerpo %}
        <div class="mb-3">
            <label for="tipo" class="form-label fw-semibold">Tipo <span class="text-danger">*</span></label>
            <select class="form-select" id="tipo" name="tipo" required>
                <option value="">— Seleccione —</option>
                <option value="horas_extra" {{ (solicitud.tipo ?? '') == 'horas_extra' ? 'selected' : '' }}>Horas extra</option>
                <option value="vacaciones"  {{ (solicitud.tipo ?? '') == 'vacaciones'  ? 'selected' : '' }} {{ sinDiasVacaciones ? 'disabled' : '' }}>Vacaciones{{ sinDiasVacaciones ? ' (sin días disponibles)' : '' }}</option>
                <option value="permiso"     {{ (solicitud.tipo ?? '') == 'permiso'     ? 'selected' : '' }}>Permiso</option>
            </select>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label for="fecha_inicio" class="form-label fw-semibold">Fecha de inicio <span class="text-danger">*</span></label>
                <input type="date" class="form-control" id="fecha_inicio" name="fecha_inicio" required value="{{ solicitud.fecha_inicio ?? '' }}">
            </div>
            <div class="col-md-6">
                <label for="fecha_fin" class="form-label fw-semibold">Fecha de fin</label>
                <input type="date" class="form-control" id="fecha_fin" name="fecha_fin" value="{{ solicitud.fecha_fin ?? '' }}">
                <div class="form-text">Requerida para vacaciones y permisos.</div>
            </div>
        </div>

        <div class="mb-3 mt-3" id="campoHoras">
            <label for="horas" class="form-label fw-semibold">Horas</label>
            <input type="number" step="0.01" min="0" max="999.99" class="form-control" id="horas" name="horas" value="{{ solicitud.horas ?? '' }}">
        </div>

        <div class="mb-3 mt-3 d-none" id="campoDias"
             data-saldo="{{ saldoVacaciones is not null ? saldoVacaciones.disponibles : '' }}"
             data-fin-prueba="{{ saldoVacaciones is not null and saldoVacaciones.en_prueba ? saldoVacaciones.fin_prueba : '' }}">
            <label class="form-label fw-semibold d-block">Días</label>
            <p class="mb-2" id="diasCalculados">Seleccione las fechas para calcular los días.</p>
            <div class="form-check d-none" id="checkMedioDia">
                <input class="form-check-input" type="checkbox" id="medioDia" name="medio_dia" value="1" {{ (solicitud.horas ?? null) == 0.5 ? 'checked' : '' }}>
                <label class="form-check-label" for="medioDia">Medio día</label>
            </div>
            {% if saldoVacaciones is not null %}
            <div class="d-none mt-2" id="saldoBarra">
                <div class="progress" style="height:1.1rem">
                    <div class="progress-bar bg-success" id="saldoBarraRelleno" role="progressbar" style="width:0%"></div>
                </div>
                <div class="small mt-1" id="saldoBarraTexto"></div>
                <div class="form-text">Estimado según su saldo de hoy; se confirma al enviar.</div>
            </div>
            {% endif %}
        </div>

        <div class="mb-3">
            <label for="motivo" class="form-label fw-semibold">Motivo</label>
            <textarea class="form-control" id="motivo" name="motivo" maxlength="255" rows="2">{{ solicitud.motivo ?? '' }}</textarea>
        </div>
        {% endblock %}
        {% endembed %}
    </form>
</div>
{% endblock %}
