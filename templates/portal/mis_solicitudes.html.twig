{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}Mis Solicitudes{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina('Mis solicitudes', {
    ruta: [{texto: 'Mi cuenta'}, {texto: 'Mis solicitudes'}],
    conteo: vinculado ? solicitudes|length : null,
    acciones: vinculado ? [{texto: 'Nueva solicitud', icono: 'plus-lg', url: url_for('portal.solicitudes.crear')}] : []
}) }}
{% endblock %}

{% block contenido %}
{% if not vinculado %}
<div class="card-fo text-center text-muted py-5" style="max-width:720px">
    <i class="bi bi-person-x fs-2 d-block mb-2"></i>
    Su usuario no está vinculado a un empleado.
</div>
{% else %}

{% if flashSuccess %}<div class="alert alert-success" style="max-width:900px">{{ flashSuccess }}</div>{% endif %}
{% if flashError %}<div class="alert alert-danger" style="max-width:900px">{{ flashError }}</div>{% endif %}

{% if saldoVacaciones is not null %}
<div class="card-fo mb-3" style="max-width:900px">
    <div class="d-flex flex-wrap align-items-center gap-4">
        <div>
            <div class="small text-muted">Vacaciones disponibles</div>
            <div class="fs-4 fw-bold {{ saldoVacaciones.disponibles < 0.5 ? 'text-danger' : 'text-success' }}">{{ saldoVacaciones.disponibles|number_format(1, '.', ',') }} días</div>
        </div>
        <div class="small text-muted">
            Ganados: <strong>{{ saldoVacaciones.ganados|number_format(1, '.', ',') }}</strong> ·
            Solicitados: <strong>{{ saldoVacaciones.comprometidos|number_format(1, '.', ',') }}</strong>
            <a href="{{ url_for('portal.vacaciones') }}" class="ms-2">Ver detalle</a>
        </div>
        {% if saldoVacaciones.en_prueba %}
        <div class="small text-info"><i class="bi bi-info-circle me-1"></i>En período de prueba hasta el {{ saldoVacaciones.fin_prueba|date('d/m/Y') }}</div>
        {% endif %}
    </div>
</div>
{% endif %}

{# ── Filtro por estado ───────────────────────────────── #}
<div class="card-fo mb-3" style="max-width:900px">
    <form method="GET" action="{{ url_for('portal.solicitudes') }}" class="d-flex align-items-center gap-2 flex-wrap">
        <label class="fw-semibold small mb-0">Estado:</label>
        <select name="estado" class="form-select form-select-sm" style="max-width:220px" onchange="this.form.submit()">
            <option value="">— Todos los estados —</option>
            <option value="pendiente" {{ filtroEstado == 'pendiente' ? 'selected' : '' }}>Pendiente</option>
            <option value="aprobada"  {{ filtroEstado == 'aprobada'  ? 'selected' : '' }}>Aprobada</option>
            <option value="rechazada" {{ filtroEstado == 'rechazada' ? 'selected' : '' }}>Rechazada</option>
            <option value="por_justificar" {{ filtroEstado == 'por_justificar' ? 'selected' : '' }}>Por justificar</option>
        </select>
        {% if filtroEstado %}
        <a href="{{ url_for('portal.solicitudes') }}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-x-lg"></i> Limpiar
        </a>
        {% endif %}
    </form>
</div>

<div class="card-fo" style="max-width:900px">
    <table class="table table-sm align-middle mb-0">
        <thead>
            <tr>
                <th>Tipo</th><th>Inicio</th><th>Fin</th>
                <th class="text-end">Horas</th>
                <th class="text-end">Días</th>
                <th class="text-end">Saldo restante (est.)</th>
                <th>Motivo</th><th>Estado</th><th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            {% for s in solicitudes %}
            <tr>
                <td>
                    {% if s.tipo == 'horas_extra' %}Horas extra
                    {% elseif s.tipo == 'vacaciones' %}Vacaciones
                    {% else %}Permiso{% endif %}
                </td>
                <td>{{ s.fecha_inicio|date('d/m/Y') }}</td>
                <td>{{ s.fecha_fin ? s.fecha_fin|date('d/m/Y') : '—' }}</td>
                <td class="text-end">{{ s.tipo == 'horas_extra' ? (s.horas ?? '—') : '—' }}</td>
                <td class="text-end">{{ s.dias is defined and s.dias is not null ? s.dias : '—' }}</td>
                <td class="text-end">{{ s.saldo_restante_estimado is defined and s.saldo_restante_estimado is not null ? s.saldo_restante_estimado : '—' }}</td>
                <td>{{ s.motivo ?? '—' }}</td>
                <td>
                    {{ ui.estado(s.estado) }}
                </td>
                <td class="text-center text-nowrap">
                    {% if s.estado == 'por_justificar' %}
                    <form method="POST" action="{{ url_for('portal.solicitudes.justificar', {'id': s.id_solicitud}) }}" class="d-flex gap-1">
                        <input type="text" name="motivo" maxlength="255" required class="form-control form-control-sm" placeholder="¿Qué hiciste?">
                        <button class="btn btn-sm btn-primary text-nowrap">Justificar</button>
                    </form>
                    {% endif %}
                    {% if s.estado == 'pendiente' and (s.origen ?? '') != 'asistencia' %}
                    <a href="{{ url_for('portal.solicitudes.editar', {'id': s.id_solicitud}) }}" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil-square"></i></a>
                    <button type="button" class="btn btn-sm btn-outline-danger" title="Cancelar"
                            data-bs-toggle="modal" data-bs-target="#modalCancelar"
                            data-url="{{ url_for('portal.solicitudes.eliminar', {'id': s.id_solicitud}) }}"><i class="bi bi-x-lg"></i></button>
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr><td colspan="9" class="text-center text-muted">No tiene solicitudes registradas.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalCancelar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-1"></i>Cancelar solicitud</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">¿Cancelar esta solicitud pendiente?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <form id="formCancelar" method="POST" action="">
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg me-1"></i>Cancelar solicitud</button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endif %}
{% endblock %}

{% block scripts %}
<script>
document.getElementById('modalCancelar')?.addEventListener('show.bs.modal', function (event) {
    document.getElementById('formCancelar').action = event.relatedTarget.getAttribute('data-url');
});
</script>
{% endblock %}
