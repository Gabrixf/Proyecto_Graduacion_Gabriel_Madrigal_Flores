{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}Cambiar Contraseña{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina('Cambiar contraseña', {
    ruta: [{texto: 'Mi cuenta'}, {texto: 'Cambiar contraseña'}],
    acciones: [
        {texto: 'Cancelar', tipo: 'secundario', url: url_for('dashboard')}, 
        {texto: 'Guardar', icono: 'key', form: 'form-contrasena'}
    ]
}) }}
{% endblock %}

{% block contenido %}
<div style="max-width:480px">
    <form method="POST" action="{{ url_for('portal.changePassword') }}" id="form-contrasena">
        {% embed 'partials/seccion.html.twig' with {titulo: 'Nueva contraseña'} %}
        {% block cuerpo %}

        <div class="mb-3">
            <label class="form-label fw-semibold">Contraseña actual</label>
            <input type="password" name="actual" class="form-control" required autocomplete="current-password">
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Nueva contraseña</label>
            <input type="password" name="nueva" class="form-control" required
                   minlength="8" autocomplete="new-password"
                   id="inputNueva">
            <div class="form-text">Mínimo 8 caracteres.</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Confirmar nueva contraseña</label>
            <input type="password" name="confirmar" class="form-control" required
                   minlength="8" autocomplete="new-password"
                   id="inputConfirmar">
        </div>
        {% endblock %}
        {% endembed %}
    </form>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('form-contrasena').addEventListener('submit', function (e) {
    var n = document.getElementById('inputNueva').value;
    var c = document.getElementById('inputConfirmar').value;
    if (n !== c) {
        e.preventDefault();
        alert('La nueva contraseña y su confirmación no coinciden.');
    }
});
</script>
{% endblock %}
