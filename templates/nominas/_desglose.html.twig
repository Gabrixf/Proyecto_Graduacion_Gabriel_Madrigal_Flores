{#
 # Desglose de una nómina para la fila desplegable de la lista (solo lectura).
 # Lo pide app.js a GET /nominas/{id}/desglose. Parámetro: nomina (NominasService::desglose).
 #}
<div class="lb-desglose">
    <div class="row g-3">
        <div class="col-md-6">
            <h3 class="lb-desglose__titulo">Ingresos</h3>
            <table class="table table-sm mb-0">
                <tbody>
                {% for i in nomina.ingresos %}
                    <tr><td>{{ i.descripcion ?: i.tipo }}</td><td class="text-end">₡{{ i.monto|number_format(2, '.', ',') }}</td></tr>
                {% else %}
                    <tr><td colspan="2" class="text-muted">Sin ingresos.</td></tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="fw-bold"><td>Bruto</td><td class="text-end">₡{{ nomina.salario_bruto|number_format(2, '.', ',') }}</td></tr>
                </tfoot>
            </table>
        </div>
        <div class="col-md-6">
            <h3 class="lb-desglose__titulo">Deducciones</h3>
            <table class="table table-sm mb-0">
                <tbody>
                {% for d in nomina.deducciones_neto %}
                    <tr><td>{{ d.descripcion ?: d.tipo }}</td><td class="text-end">₡{{ d.monto|number_format(2, '.', ',') }}</td></tr>
                {% else %}
                    <tr><td colspan="2" class="text-muted">Sin deducciones.</td></tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="fw-bold"><td>Total deducciones</td><td class="text-end">₡{{ nomina.total_deducciones|number_format(2, '.', ',') }}</td></tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="lb-desglose__neto">
        <span>Neto a pagar</span>
        <span>₡{{ nomina.salario_neto|number_format(2, '.', ',') }}</span>
    </div>

    <div class="small text-muted mt-2">
        CCSS patronal (informativa, la paga el patrono): ₡{{ nomina.ccss_patronal|number_format(2, '.', ',') }}
    </div>
    <div class="small text-muted mt-1">
        <span class="fw-semibold">Ausencias del período:</span>
        {% include 'nominas/_ausencias.html.twig' with {aus: nomina.ausencias ?? null} %}
    </div>

    <div class="d-flex gap-2 justify-content-end mt-2">
        <a href="{{ url_for('nominas.exportarNomina', {id: nomina.id_nomina, formato: 'xlsx'}) }}" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i>Excel
        </a>
        <a href="{{ url_for('nominas.exportarNomina', {id: nomina.id_nomina, formato: 'pdf'}) }}" class="btn btn-sm btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
        </a>
        <a href="{{ url_for('nominas.show', {id: nomina.id_nomina}) }}" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-eye me-1"></i>Ver / editar
        </a>
    </div>
</div>
