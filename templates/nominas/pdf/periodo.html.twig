<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>{{ titulo }}</title>
<style>
    @page { margin: 24px 24px; }
    body { font-family: DejaVu Sans, sans-serif; font-size: 8px; color: #1a1a1a; }
    h1 { font-size: 14px; margin: 0 0 4px; color: #0d1b3e; }
    .subtitulo { font-size: 9px; color: #555; margin: 0 0 10px; }
    .aviso { font-size: 9px; color: #8a4b00; background: #fff3cd; padding: 4px 6px; margin: 0 0 10px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    th, td { padding: 4px 4px; border-bottom: 1px solid #ddd; text-align: left; }
    th { background: #0d1b3e; color: #fff; font-weight: bold; }
    td.num, th.num { text-align: right; }
    tfoot td { font-weight: bold; background: #f2f2f2; border-top: 2px solid #0d1b3e; }
    h2 { font-size: 11px; margin: 14px 0 6px; color: #0d1b3e; }
    .resumen td { font-size: 10px; }
</style>
</head>
<body>
    <h1>Lubrimotos del Sur — {{ titulo }}</h1>
    <p class="subtitulo">Generado el {{ 'now'|date('d/m/Y H:i') }}</p>
    {% if incluye_borrador %}
    <p class="aviso">Este reporte incluye nóminas en borrador, cuyos montos aún pueden cambiar.</p>
    {% endif %}
    <table>
        <thead>
            <tr>
                <th>Empleado</th><th>Cédula</th>
                <th class="num">Salario base</th><th class="num">Horas extra</th><th class="num">Otros ingresos</th>
                <th class="num">Subsidio incap.</th><th class="num">Bruto</th><th class="num">CCSS obrera</th>
                <th class="num">Renta</th><th class="num">Otras deducc.</th><th class="num">Neto</th>
                <th class="num">CCSS patronal</th><th>Estado</th>
            </tr>
        </thead>
        <tbody>
            {% for f in filas %}
            <tr>
                <td>{{ f.apellidos }}, {{ f.nombre }}</td>
                <td>{{ f.cedula }}</td>
                <td class="num">{{ f.salario_base|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.horas_extra|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.otros_ingresos|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.subsidio|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.salario_bruto|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.ccss_obrera|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.renta|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.otras_deducciones|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.salario_neto|number_format(2, '.', ',') }}</td>
                <td class="num">{{ f.ccss_patronal|number_format(2, '.', ',') }}</td>
                <td>{{ f.estado }}</td>
            </tr>
            {% else %}
            <tr><td colspan="13">No hay nóminas en este período.</td></tr>
            {% endfor %}
        </tbody>
        {% if filas %}
        <tfoot>
            <tr>
                <td colspan="2">TOTAL ({{ filas|length }})</td>
                <td class="num">{{ totales.salario_base|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.horas_extra|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.otros_ingresos|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.subsidio|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.salario_bruto|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.ccss_obrera|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.renta|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.otras_deducciones|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.salario_neto|number_format(2, '.', ',') }}</td>
                <td class="num">{{ totales.ccss_patronal|number_format(2, '.', ',') }}</td>
                <td></td>
            </tr>
        </tfoot>
        {% endif %}
    </table>
    <h2>Resumen</h2>
    <table class="resumen">
        <tr><td>Total pagado (neto)</td><td class="num">{{ totales.salario_neto|number_format(2, '.', ',') }}</td></tr>
        <tr><td>Cargas sociales a pagar a la CCSS</td><td class="num">{{ totales.cargas_ccss|number_format(2, '.', ',') }}</td></tr>
        <tr><td>Renta retenida a pagar a Hacienda</td><td class="num">{{ totales.renta|number_format(2, '.', ',') }}</td></tr>
    </table>
</body>
</html>
