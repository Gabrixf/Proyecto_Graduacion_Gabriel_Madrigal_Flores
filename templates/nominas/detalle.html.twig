{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}Detalle de Nómina{% endblock %}

{% block encabezado %}
{% set acciones_nomina = [] %}
{% if nomina.estado == 'borrador' %}
    {% set acciones_nomina = [
        {texto: 'Regenerar', icono: 'arrow-repeat', tipo: 'secundario', atributos: {'data-bs-toggle': 'modal', 'data-bs-target': '#modalRegenerar'}},
        {texto: 'Aprobar', icono: 'check2-circle', atributos: {'data-bs-toggle': 'modal', 'data-bs-target': '#modalAprobar'}}
    ] %}
{% elseif nomina.estado == 'aprobado' %}
    {% set acciones_nomina = [{texto: 'Marcar como pagada', icono: 'cash-coin', atributos: {'data-bs-toggle': 'modal', 'data-bs-target': '#modalPagar'}}] %}
{% endif %}
{{ ui.encabezado_pagina(nomina.nombre ~ ' ' ~ nomina.apellidos, {
    ruta: [{texto: 'Nómina'}, {texto: 'Nóminas', url: url_for('nominas.index') ~ '?periodo=' ~ nomina.id_periodo}, {texto: 'Detalle'}],
    estado: nomina.estado,
    acciones: acciones_nomina
}) }}
{% endblock %}

{% block contenido %}
{% set editable = nomina.estado == 'borrador' %}

{% embed 'partials/seccion.html.twig' with {titulo: 'Resumen'} %}
{% block cuerpo %}
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
        <div class="text-muted small">Periodo: {{ nomina.fecha_inicio }} a {{ nomina.fecha_fin }}</div>
        <div class="text-end">
            <div class="text-muted small">Salario neto</div>
            <div class="fs-3 fw-bold">₡{{ nomina.salario_neto|number_format(2, '.', ',') }}</div>
        </div>
    </div>
{% endblock %}
{% endembed %}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="lb-tabla h-100">
            <h2 class="lb-seccion__titulo px-3 pt-3">Ingresos</h2>
            <div class="table-responsive px-2">
            <table class="table table-sm align-middle mb-0">
                <tbody>
                {% for i in nomina.ingresos %}
                    <tr>
                        <td>{{ i.descripcion ?? i.tipo }}</td>
                        <td class="text-end">₡{{ i.monto|number_format(2, '.', ',') }}</td>
                        <td class="text-end" style="width:40px">
                            {% if editable and i.tipo != 'salario_base' %}
                            <form method="POST" action="{{ url_for('nominas.removeLinea', {id: nomina.id_nomina, tipo: 'ingreso', idLinea: i.id_ingreso}) }}">
                                <button class="btn btn-sm btn-link text-danger p-0" title="Quitar"><i class="bi bi-x-circle"></i></button>
                            </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="fw-bold"><td>Total ingresos (bruto)</td><td class="text-end">₡{{ nomina.salario_bruto|number_format(2, '.', ',') }}</td><td></td></tr>
                </tfoot>
            </table>
            </div>
            {% if editable %}
            <form method="POST" action="{{ url_for('nominas.addIngreso', {id: nomina.id_nomina}) }}" class="row g-1 p-3">
                <div class="col-4"><select name="tipo" class="form-select form-select-sm">
                    <option value="bonificacion">Bonificación</option>
                    <option value="feriado">Feriado</option>
                    <option value="otro">Otro</option>
                </select></div>
                <div class="col-4"><input name="descripcion" class="form-control form-control-sm" placeholder="Descripción"></div>
                <div class="col-3"><input name="monto" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="Monto" required></div>
                <div class="col-1"><button class="btn btn-sm btn-primary w-100"><i class="bi bi-plus"></i></button></div>
            </form>
            {% endif %}
        </div>
    </div>

    <div class="col-lg-6">
        <div class="lb-tabla h-100">
            <h2 class="lb-seccion__titulo px-3 pt-3">Deducciones</h2>
            <div class="table-responsive px-2">
            <table class="table table-sm align-middle mb-0">
                <tbody>
                {% for d in nomina.deducciones %}
                    <tr class="{{ d.tipo == 'CCSS_patronal' ? 'text-muted' : '' }}">
                        <td>{{ d.descripcion ?? d.tipo }}{% if d.tipo == 'CCSS_patronal' %} {{ ui.etiqueta('informativa', 'ambar') }}{% endif %}</td>
                        <td class="text-end">₡{{ d.monto|number_format(2, '.', ',') }}</td>
                        <td class="text-end" style="width:40px">
                            {% if editable and d.tipo not in ['CCSS_empleado','CCSS_patronal'] %}
                            <form method="POST" action="{{ url_for('nominas.removeLinea', {id: nomina.id_nomina, tipo: 'deduccion', idLinea: d.id_deduccion}) }}">
                                <button class="btn btn-sm btn-link text-danger p-0" title="Quitar"><i class="bi bi-x-circle"></i></button>
                            </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="fw-bold"><td>Total deducciones (afectan neto)</td><td class="text-end">₡{{ nomina.total_deducciones|number_format(2, '.', ',') }}</td><td></td></tr>
                </tfoot>
            </table>
            </div>
            {% if editable %}
            <form method="POST" action="{{ url_for('nominas.addDeduccion', {id: nomina.id_nomina}) }}" class="row g-1 p-3">
                <div class="col-4"><select name="tipo" class="form-select form-select-sm">
                    <option value="embargo">Embargo</option>
                    <option value="otro">Otro</option>
                </select></div>
                <div class="col-4"><input name="descripcion" class="form-control form-control-sm" placeholder="Descripción"></div>
                <div class="col-3"><input name="monto" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="Monto" required></div>
                <div class="col-1"><button class="btn btn-sm btn-primary w-100"><i class="bi bi-plus"></i></button></div>
            </form>
            {% endif %}
        </div>
    </div>
</div>

{# ── Modal: Regenerar nómina ────────────────────────────────── #}
<div class="modal fade" id="modalRegenerar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title"><i class="bi bi-arrow-repeat me-1"></i>Regenerar nómina</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <p>Se vuelve a calcular con las incapacidades, permisos, vacaciones, horas extra y asistencia actuales.</p>
      <p class="text-danger small mb-0">Se pierden las líneas agregadas a mano (bonos, embargos).</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
      <form method="POST" action="{{ url_for('nominas.regenerar', {id: nomina.id_nomina}) }}"><button type="submit" class="btn btn-danger">Regenerar</button></form>
    </div>
  </div></div>
</div>

{# ── Modal: Aprobar nómina ──────────────────────────────────── #}
<div class="modal fade" id="modalAprobar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-check2-circle me-1"></i>Aprobar nómina</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Aprobar la nómina de <strong>{{ nomina.nombre }} {{ nomina.apellidos }}</strong>?</p>
                <p class="text-muted small mb-0">El estado cambiará de <em>borrador</em> a <em>aprobado</em>. Aún podrá marcarse como pagada en el siguiente paso.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="POST" action="{{ url_for('nominas.aprobar', {id: nomina.id_nomina}) }}">
                    <button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Aprobar</button>
                </form>
            </div>
        </div>
    </div>
</div>

{# ── Modal: Marcar pagada ───────────────────────────────────── #}
<div class="modal fade" id="modalPagar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-cash-coin me-1"></i>Marcar como pagada</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Confirmar el pago de la nómina de <strong>{{ nomina.nombre }} {{ nomina.apellidos }}</strong>?</p>
                <p class="mb-1">Salario neto: <strong>₡{{ nomina.salario_neto|number_format(2, '.', ',') }}</strong></p>
                <p class="text-muted small mb-0">Esta acción es irreversible. La colilla quedará disponible para el empleado en su portal.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="POST" action="{{ url_for('nominas.pagar', {id: nomina.id_nomina}) }}">
                    <button class="btn btn-success"><i class="bi bi-cash-coin me-1"></i>Confirmar pago</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
