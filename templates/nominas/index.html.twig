{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% set verTodos = filtroPeriodo == 'todos' %}
{% set puedeGenerar = periodo is not null and periodo.estado == 'abierto' %}
{% set nBorrador = conteoPeriodo is not null ? conteoPeriodo.borrador.cantidad : 0 %}
{% set nAprobado = conteoPeriodo is not null ? conteoPeriodo.aprobado.cantidad : 0 %}
{% set accionesMasivas = [] %}
{% if puedeGenerar %}
    {% set accionesMasivas = accionesMasivas|merge([{texto: 'Generar nóminas del periodo', icono: 'gear-fill', atributos: {'data-bs-toggle': 'modal', 'data-bs-target': '#modalGenerar'}}]) %}
{% endif %}
{% if nBorrador > 0 %}
    {% set accionesMasivas = accionesMasivas|merge([{texto: 'Aprobar todas', icono: 'check2-all', atributos: {'data-bs-toggle': 'modal', 'data-bs-target': '#modalAprobarTodas'}}]) %}
{% endif %}
{% if nAprobado > 0 %}
    {% set accionesMasivas = accionesMasivas|merge([{texto: 'Marcar todas como pagadas', icono: 'cash-stack', atributos: {'data-bs-toggle': 'modal', 'data-bs-target': '#modalPagarTodas'}}]) %}
{% endif %}

{% block titulo %}Nóminas{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina('Nóminas', {
    ruta: [{texto: 'Nómina'}, {texto: 'Nóminas'}],
    conteo: nominas|length,
    acciones: accionesMasivas
}) }}
{% endblock %}

{% block contenido %}
<div class="mb-3">
    <form method="GET" action="{{ url_for('nominas.index') }}" class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-5">
            <label class="form-label small fw-semibold" for="filtroPeriodo">Periodo de pago</label>
            <select name="periodo" id="filtroPeriodo" class="form-select" onchange="this.form.submit()">
                <option value="todos" {{ verTodos ? 'selected' : '' }}>— Todos los periodos —</option>
                {% for p in periodos %}
                <option value="{{ p.id_periodo }}" {{ filtroPeriodo == p.id_periodo ? 'selected' : '' }}>
                    {{ p.fecha_inicio|date('d/m/Y') }} – {{ p.fecha_fin|date('d/m/Y') }} ({{ p.estado }})
                </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-sm-4 col-md-3">
            <label class="form-label small fw-semibold" for="filtroEstado">Estado</label>
            <select name="estado" id="filtroEstado" class="form-select" onchange="this.form.submit()">
                <option value="">— Todos —</option>
                {% for e in ['borrador', 'aprobado', 'pagado'] %}
                <option value="{{ e }}" {{ filtroEstado == e ? 'selected' : '' }}>{{ e|capitalize }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <a href="{{ url_for('nominas.index') }}" class="btn btn-outline-primary" title="Volver al periodo actual">Periodo actual</a>
        </div>
        {% if periodo %}
        <div class="col-auto">
            <a href="{{ url_for('nominas.exportar', {formato: 'xlsx'}) }}?periodo={{ periodo.id_periodo }}" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
            <a href="{{ url_for('nominas.exportar', {formato: 'pdf'}) }}?periodo={{ periodo.id_periodo }}" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
        </div>
        {% endif %}
    </form>
    {% if puedeGenerar %}
    <form id="formGenerar" method="POST" action="{{ url_for('nominas.generate') }}" class="d-none">
        <input type="hidden" name="id_periodo" value="{{ periodo.id_periodo }}">
    </form>
    {% endif %}
</div>

<p class="text-muted small mb-2">
    {% if periodo %}
        Mostrando el periodo del <strong>{{ periodo.fecha_inicio|date('d/m/Y') }}</strong> al <strong>{{ periodo.fecha_fin|date('d/m/Y') }}</strong> {{ ui.estado(periodo.estado) }}
    {% else %}
        Mostrando el histórico de todos los periodos, del más reciente al más antiguo.
    {% endif %}
</p>

<div class="lb-tabla">
    <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                {% if verTodos %}<th>Periodo</th>{% endif %}
                <th>Empleado</th><th class="text-end">Salario base</th>
                <th class="text-end">Bruto</th><th class="text-end">Deducciones</th>
                <th class="text-end">Neto</th><th>Estado</th><th></th>
            </tr>
        </thead>
        <tbody>
            {% for n in nominas %}
            <tr>
                {% if verTodos %}<td class="text-nowrap">{{ n.fecha_inicio|date('d/m/Y') }} – {{ n.fecha_fin|date('d/m/Y') }}</td>{% endif %}
                <td class="fw-semibold">{{ n.nombre }} {{ n.apellidos }}</td>
                <td class="text-end">₡{{ n.salario_base|number_format(2, '.', ',') }}</td>
                <td class="text-end">₡{{ n.salario_bruto|number_format(2, '.', ',') }}</td>
                <td class="text-end">₡{{ n.total_deducciones|number_format(2, '.', ',') }}</td>
                <td class="text-end fw-bold">₡{{ n.salario_neto|number_format(2, '.', ',') }}</td>
                <td>
                    {{ ui.estado(n.estado) }}
                </td>
                <td class="text-end">
                    <a href="{{ url_for('nominas.show', {id: n.id_nomina}) }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye"></i> Ver
                    </a>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="{{ verTodos ? 8 : 7 }}" class="text-center text-muted py-4">
                {% if puedeGenerar %}
                    No hay nóminas en este periodo. Usa “Generar nóminas del periodo”.
                {% else %}
                    No hay nóminas que coincidan con los filtros.
                {% endif %}
            </td></tr>
            {% endfor %}
        </tbody>
        {% if nominas is not empty %}
        <tfoot>
            <tr class="fw-bold">
                <td colspan="{{ verTodos ? 3 : 2 }}">Total</td>
                <td class="text-end">₡{{ resumen.bruto|number_format(2, '.', ',') }}</td>
                <td class="text-end">₡{{ resumen.deducciones|number_format(2, '.', ',') }}</td>
                <td class="text-end">₡{{ resumen.neto|number_format(2, '.', ',') }}</td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
        {% endif %}
    </table>
    </div>
    <div class="lb-tabla__pie">{{ nominas|length }} {{ nominas|length == 1 ? 'nómina' : 'nóminas' }}</div>
</div>

{% if puedeGenerar %}
<div class="modal fade" id="modalGenerar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-gear-fill me-1"></i>Generar nóminas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Generar las nóminas del periodo del {{ periodo.fecha_inicio|date('d/m/Y') }} al {{ periodo.fecha_fin|date('d/m/Y') }}?</p>
                <p class="text-muted small mb-0">Se calculará la planilla de todos los empleados activos con salario base, horas extra aprobadas y deducciones legales.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formGenerar" class="btn btn-primary">
                    <i class="bi bi-gear-fill me-1"></i>Generar
                </button>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% if nBorrador > 0 %}
<div class="modal fade" id="modalAprobarTodas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-check2-all me-1"></i>Aprobar todas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Se aprobarán {{ nBorrador }} {{ nBorrador == 1 ? 'nómina' : 'nóminas' }} del {{ periodo.fecha_inicio|date('d/m/Y') }} al {{ periodo.fecha_fin|date('d/m/Y') }} · total neto ₡{{ conteoPeriodo.borrador.neto|number_format(2, '.', ',') }}</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="POST" action="{{ url_for('nominas.aprobarPeriodo', {id: periodo.id_periodo}) }}" class="d-inline">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-all me-1"></i>Aprobar</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% if nAprobado > 0 %}
<div class="modal fade" id="modalPagarTodas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-cash-stack me-1"></i>Marcar todas como pagadas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Se marcarán como pagadas {{ nAprobado }} {{ nAprobado == 1 ? 'nómina' : 'nóminas' }} del {{ periodo.fecha_inicio|date('d/m/Y') }} al {{ periodo.fecha_fin|date('d/m/Y') }} · total neto ₡{{ conteoPeriodo.aprobado.neto|number_format(2, '.', ',') }}</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="POST" action="{{ url_for('nominas.pagarPeriodo', {id: periodo.id_periodo}) }}" class="d-inline">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-cash-stack me-1"></i>Marcar como pagadas</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
