{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}{{ titulo }}{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina(titulo, {
    ruta: [{texto: 'Nómina'}, {texto: 'Evaluaciones', url: url_for('evaluaciones.index')}, {texto: titulo == 'Editar Evaluación' ? 'Editar' : 'Nueva'}],
    acciones: [
        {texto: 'Cancelar', tipo: 'secundario', url: url_for('evaluaciones.index')},
        {texto: 'Guardar evaluación', icono: 'floppy', form: 'form-evaluacion'}
    ]
}) }}
{% endblock %}

{% block contenido %}
<div style="max-width:720px">
    {% if errores %}
    <div class="alert alert-danger">
        {% for e in errores %}<div><i class="bi bi-exclamation-triangle-fill me-1"></i>{{ e }}</div>{% endfor %}
    </div>
    {% endif %}

    <form method="POST" action="{{ accion }}" id="form-evaluacion">
        {% embed 'partials/seccion.html.twig' with {titulo: 'Datos de la evaluación'} %}
        {% block cuerpo %}
            <div class="mb-3">
                <label class="form-label fw-semibold">Empleado</label>
                <select name="id_empleado" class="form-select" required>
                    <option value="">— Seleccione —</option>
                    {% for e in empleados %}
                    <option value="{{ e.id_empleado }}" {{ datos.id_empleado == e.id_empleado ? 'selected' : '' }}>
                        {{ e.nombre }} {{ e.apellidos }}
                    </option>
                    {% endfor %}
                </select>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Año evaluado</label>
                    <input type="number" name="periodo_evaluado" min="2000" max="{{ "now"|date('Y') }}"
                           value="{{ datos.periodo_evaluado ?? "now"|date('Y') }}" class="form-control" required>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Fecha de evaluación</label>
                    <input type="date" name="fecha_evaluacion" value="{{ datos.fecha_evaluacion }}" class="form-control" required>
                </div>
            </div>
        {% endblock %}
        {% endembed %}

        <div class="lb-tabla mb-3">
            <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Criterio (escala 1–100)</th><th class="text-center" style="width:90px">Peso</th>
                        <th style="width:140px">Puntaje</th></tr>
                </thead>
                <tbody>
                    {% for d in detalles %}
                    <tr>
                        <td>
                            {{ d.criterio }}
                            <input type="hidden" name="criterio[]" value="{{ d.criterio }}">
                        </td>
                        <td class="text-center">
                            {{ d.peso|number_format(0) }} %
                            <input type="hidden" name="peso[]" value="{{ d.peso }}">
                        </td>
                        <td>
                            <input type="number" name="puntaje[]" value="{{ d.puntaje }}"
                                   min="1" max="100" step="0.01" class="form-control" required>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>

        {% embed 'partials/seccion.html.twig' with {titulo: 'Observaciones'} %}
        {% block cuerpo %}
            <label class="form-label text-muted">Opcional</label>
            <textarea name="observaciones" class="form-control" rows="3" maxlength="500">{{ datos.observaciones }}</textarea>
        {% endblock %}
        {% endembed %}
    </form>
</div>
{% endblock %}
