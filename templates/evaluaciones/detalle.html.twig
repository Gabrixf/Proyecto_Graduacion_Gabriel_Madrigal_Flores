{% extends 'layouts/base.html.twig' %}
{% import 'partials/ui.html.twig' as ui %}

{% block titulo %}Detalle de Evaluación{% endblock %}

{% block encabezado %}
{{ ui.encabezado_pagina(evaluacion.nombre ~ ' ' ~ evaluacion.apellidos, {
    ruta: [{texto: 'Nómina'}, {texto: 'Evaluaciones', url: url_for('evaluaciones.index')}, {texto: 'Detalle'}],
    acciones: [
        {texto: 'Eliminar', icono: 'trash', tipo: 'peligro', form: 'form-eliminar-evaluacion'},
        {texto: 'Editar', icono: 'pencil-square', url: url_for('evaluaciones.edit', {id: evaluacion.id_evaluacion})}
    ]
}) }}
{% endblock %}

{% block contenido %}
<div style="max-width:720px">
    {% embed 'partials/seccion.html.twig' with {titulo: 'Resumen'} %}
    {% block cuerpo %}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="text-muted small">
                Año evaluado: {{ evaluacion.periodo_evaluado }} ·
                Fecha: {{ evaluacion.fecha_evaluacion }}
            </div>
            {% include 'partials/eval_badge.html.twig' with {puntaje: evaluacion.puntaje_total} only %}
        </div>
    {% endblock %}
    {% endembed %}

    <div class="lb-tabla mb-3">
        <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Criterio</th><th class="text-center">Peso</th>
                    <th class="text-end">Puntaje</th><th class="text-end">Aporte</th></tr>
            </thead>
            <tbody>
                {% for d in evaluacion.detalles %}
                <tr>
                    <td>{{ d.criterio }}</td>
                    <td class="text-center">{{ d.peso|number_format(0) }} %</td>
                    <td class="text-end">{{ d.puntaje|number_format(2, '.', ',') }}</td>
                    <td class="text-end">{{ (d.puntaje * d.peso / 100)|number_format(2, '.', ',') }}</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="fw-bold fs-5"><td colspan="3">Puntaje total</td>
                    <td class="text-end">{{ evaluacion.puntaje_total|number_format(2, '.', ',') }}</td></tr>
            </tfoot>
        </table>
        </div>
    </div>

    {% if evaluacion.observaciones %}
    {% embed 'partials/seccion.html.twig' with {titulo: 'Observaciones'} %}
    {% block cuerpo %}
        <p class="text-muted mb-0">{{ evaluacion.observaciones }}</p>
    {% endblock %}
    {% endembed %}
    {% endif %}

    <form id="form-eliminar-evaluacion" method="POST" action="{{ url_for('evaluaciones.destroy', {id: evaluacion.id_evaluacion}) }}"
          onsubmit="return confirm('¿Eliminar esta evaluación?');"></form>
</div>
{% endblock %}
