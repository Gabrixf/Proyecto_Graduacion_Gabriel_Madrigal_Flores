<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>{{ titulo }}</title>
<style>
    @page { margin: 30px 36px; }
    body { font-family: DejaVu Sans, sans-serif; font-size: 10px; color: #1a1a1a; }
    h1 { font-size: 16px; margin: 0 0 4px; color: #0d1b3e; }
    .subtitulo { font-size: 10px; color: #555; margin: 0 0 16px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    th, td { padding: 5px 6px; border-bottom: 1px solid #ddd; text-align: left; }
    th { background: #0d1b3e; color: #fff; font-weight: bold; }
    td.num, th.num { text-align: right; }
    tfoot td { font-weight: bold; background: #f2f2f2; border-top: 2px solid #0d1b3e; }
    h2 { font-size: 12px; margin: 18px 0 6px; color: #0d1b3e; }
</style>
</head>
<body>
    <h1>{{ titulo }}</h1>
    <p class="subtitulo">Lubrimotos del Sur — Generado el {{ "now"|date("d/m/Y H:i") }}</p>
    {% block contenido %}{% endblock %}
</body>
</html>
