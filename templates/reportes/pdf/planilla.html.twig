{% extends 'reportes/pdf/_layout.html.twig' %}

{% block contenido %}
<table>
    <thead>
        <tr><th>Empleado</th><th>Cédula</th><th>Estado</th>
            <th class="num">Salario bruto</th><th class="num">Deducciones</th><th class="num">Salario neto</th></tr>
    </thead>
    <tbody>
        {% for f in filas %}
        <tr>
            <td>{{ f.nombre }} {{ f.apellidos }}</td>
            <td>{{ f.cedula }}</td>
            <td>{{ f.estado }}</td>
            <td class="num">{{ f.salario_bruto|number_format(2, '.', ',') }}</td>
            <td class="num">{{ f.total_deducciones|number_format(2, '.', ',') }}</td>
            <td class="num">{{ f.salario_neto|number_format(2, '.', ',') }}</td>
        </tr>
        {% else %}
        <tr><td colspan="6">Sin datos para el período seleccionado.</td></tr>
        {% endfor %}
    </tbody>
    {% if filas %}
    <tfoot>
        <tr>
            <td colspan="3">Totales ({{ filas|length }} empleado{{ filas|length != 1 ? 's' : '' }})</td>
            <td class="num">{{ totales.bruto|number_format(2, '.', ',') }}</td>
            <td class="num">{{ totales.deducciones|number_format(2, '.', ',') }}</td>
            <td class="num">{{ totales.neto|number_format(2, '.', ',') }}</td>
        </tr>
    </tfoot>
    {% endif %}
</table>
{% endblock %}
